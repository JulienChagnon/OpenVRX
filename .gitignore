lab/out/

# Recordings and decoded output. Anything decoded from a real capture
# (frames, FM strips, reconstructions, video) shows the owner's camera
# view and must never reach a remote: it stays local.
recordings/
*.rx[0-9].bin
*.rx[0-9][0-9].bin
*.truth.f32
*.openvrx.json
*.events.jsonl
openvrx-out/
bench-runs/
lab/results/**/*.png
lab/results/**/*.jpg
lab/results/**/*.jpeg
lab/results/**/*.bmp
lab/results/**/*.gif
lab/results/**/*.webp
lab/results/**/*.npy
lab/results/**/*.npz
lab/results/R0_*
*-frame[0-9]*.png
*-fmstrip.png
*.mp4
*.mkv
*.avi
*.mov
*.y4m
# Golden vectors are small and versioned on purpose.
!lab/golden/**

