# SPDX-License-Identifier: GPL-3.0-or-later
# OpenVRX C5 radio head. Wi-Fi, PHY and buffer settings follow C5VRX's
# sdkconfig.defaults (C5VRX by Twotoz and the C5VRX contributors, commit
# 6bc9e4bbb5bef5948d42a065da27eae39315ad2d): Wi-Fi is only the RF front end.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 4 MB fits both the XIAO (8 MB) and the C5-Zero (ESP32-C5HF4, 4 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
# Only warnings and errors reach the console, as "LOG " lines.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_COLORS=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# No traffic: minimum RX buffers, no A-MPDU, no Wi-Fi IRAM placement.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
# No PHY tracking timer: it would recalibrate RF during streaming.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
# Power management off: clocks must never change under the sample clock.
CONFIG_PM_ENABLE=n
CONFIG_SPIRAM=n
